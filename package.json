{
  "name": "job-application-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, user-controlled job application autofill copilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utkarshx27/job-application-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/utkarshx27/job-application-copilot/issues"
  },
  "homepage": "https://github.com/utkarshx27/job-application-copilot#readme",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "job-application",
    "autofill",
    "ats",
    "local-first"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:resumes": "node scripts/generate-resume-fixtures.mjs",
    "ats:qa:discover": "node --experimental-strip-types scripts/ats-qa.ts discover",
    "ats:qa:capture": "node --experimental-strip-types scripts/ats-qa.ts capture",
    "ats:qa:init-review": "node --experimental-strip-types scripts/ats-qa.ts init-review",
    "ats:qa:replay": "node --experimental-strip-types scripts/ats-qa.ts replay",
    "ats:qa:import-reviewed": "node --experimental-strip-types scripts/ats-qa.ts import-reviewed",
    "ats:qa:signoff-pages": "node --experimental-strip-types scripts/ats-qa.ts signoff-pages",
    "ats:qa:seed-controlled": "node --experimental-strip-types scripts/ats-qa.ts seed-controlled",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:e2e": "npm run build:e2e --workspace @copilot/extension && npm run build --workspace @copilot/test-ats && playwright test --config evals/end-to-end/playwright.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:phase0": "npm run check && npm run test:e2e",
    "check:phase1": "npm run check && npm run test:e2e",
    "check:phase2": "npm run check && npm run test:e2e",
    "check:phase3": "npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "docx": "^9.7.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
